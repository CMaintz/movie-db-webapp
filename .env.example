# Firebase config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# TMDB API key (for most requests)
VITE_TMDB_API_KEY=your_tmdb_api_key

# TMDB Read Access Token (for watch/providers endpoint — get from TMDB API settings)
VITE_TMDB_READ_TOKEN=your_tmdb_read_access_token

# ISO 3166-1 country code for streaming availability (e.g. US, GB, NO)
VITE_WATCH_REGION=US

# OMDb API key for IMDb + Rotten Tomatoes scores (free tier: 1000 req/day)
# Get one at https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=your_omdb_api_key

# ──────────────────────────────────────────────────────────────────────────────
# WebOS / sideloaded deployment:
#   Copy public/appconfig.example.js → public/appconfig.js and fill in keys there.
#   That file is loaded at runtime (before the app bundle) so you can edit it on
#   the TV via SSH without rebuilding. The .env vars above serve as dev fallbacks.
# ──────────────────────────────────────────────────────────────────────────────
