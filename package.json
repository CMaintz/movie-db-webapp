{
  "name": "mdb.json",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "preview": "vite preview",
    "build:tv": "npm run build && shx cp webos/appinfo.json dist/ && shx cp webos/icon.png dist/ && shx cp webos/largeIcon.png dist/",
    "package:tv": "npm run build:tv && ares-package dist -o webos",
    "install:tv": "npm run package:tv && ares-install webos/com.mdb.app_1.0.0_all.ipk",
    "launch:tv": "ares-launch com.mdb.app",
    "inspect:tv": "ares-inspect --app com.mdb.app --open"
  },
  "dependencies": {
    "@noriginmedia/norigin-spatial-navigation": "^2.3.0",
    "@tanstack/react-query": "^5.74.4",
    "firebase": "^11.6.0",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-responsive-carousel": "^3.2.23",
    "react-router-dom": "^7.5.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jscpd": "^5.1.2",
    "jsdom": "^29.1.1",
    "knip": "^6.34.0",
    "postcss": "^8.5.8",
    "shx": "^0.3.4",
    "tailwindcss": "^3.4.19",
    "ts-morph": "^28.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
    "vitest": "^5.0.0"
  }
}
