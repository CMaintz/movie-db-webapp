rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only see and change their own wishlist.
    match /users/{userId}/wishlist/{itemId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function isValidItem(item) {
        return item.keys().hasOnly(['mediaId', 'mediaType', 'addedAt'])
          && item.keys().hasAll(['mediaId', 'mediaType', 'addedAt'])
          && item.mediaId is int
          && item.mediaType in ['movie', 'tv']
          && item.addedAt is timestamp;
      }

      allow read, delete: if isOwner();
      allow create: if isOwner() && isValidItem(request.resource.data);
    }
  }
}
